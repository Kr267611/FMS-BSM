{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fms-bsm.onrender.com/api/:path*"
    },
    {
      "source": "/(login|forgot-password|reset-password|jobs|mis|processes|sheets|reminders|users|org|audit|account|calendar|checklists|delegations|dashboard|audits)",
      "destination": "/index.html"
    },
    {
      "source": "/users/:rest*",
      "destination": "/index.html"
    },
    {
      "source": "/processes/:rest*",
      "destination": "/index.html"
    },
    {
      "source": "/fms/:rest*",
      "destination": "/index.html"
    },
    {
      "source": "/mis/:rest*",
      "destination": "/index.html"
    },
    {
      "source": "/reports/:rest*",
      "destination": "/index.html"
    },
    {
      "source": "/checklists/:rest*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "30 3 * * *"
    }
  ]
}
