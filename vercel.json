{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fms-bsm.onrender.com/api/:path*"
    },
    {
      "source": "/(login|forgot-password|reset-password|jobs|mis|processes|sheets|reminders|users|org|audit|account|calendar|checklists|delegations|dashboard|audits|tickets|ai)",
      "destination": "/index.html"
    },
    {
      "source": "/users/:rest*",
      "destination": "/index.html"
    },
    {
      "source": "/processes/:rest*",
      "destination": "/index.html"
    },
    {
      "source": "/fms/:rest*",
      "destination": "/index.html"
    },
    {
      "source": "/mis/:rest*",
      "destination": "/index.html"
    },
    {
      "source": "/reports/:rest*",
      "destination": "/index.html"
    },
    {
      "source": "/checklists/:rest*",
      "destination": "/index.html"
    },
    {
      "source": "/audits/:rest*",
      "destination": "/index.html"
    },
    {
      "source": "/hr/:rest*",
      "destination": "/index.html"
    },
    {
      "source": "/tickets/:rest*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "30 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), microphone=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
