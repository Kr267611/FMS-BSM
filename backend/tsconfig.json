{
  // The backend is TypeScript compiled to CommonJS JavaScript in dist/ (npm run build).
  // `import x = require()` and `export =` keep exactly the same module shape as the old JavaScript.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["types", "server.ts", "config", "middleware", "models", "routes", "services", "templates", "scripts", "test"]
}
