{
  // TypeScript checks the backend's JavaScript (types come from JSDoc and the libraries).
  // Node runs the same files as before, so nothing changes on Render.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": false, // files opt in with // @ts-check at the top
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["types", "server.js", "config", "middleware", "models", "routes", "services", "templates", "scripts"]
}
