{
  "name": "fms-bsm-backend",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p .",
    "postinstall": "tsc -p . || echo TypeScript reported problems - see above",
    "start": "node server.js",
    "dev": "tsc -p . && node --watch server.js",
    "seed:demo": "tsc -p . && node dist/scripts/seedDemo.js",
    "test": "tsc -p . && node --test --test-concurrency=1 \"dist/test/**/*.test.js\"",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "googleapis": "^182.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "nodemailer": "^10.0.11",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "mongodb-memory-server-core": "^11.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
