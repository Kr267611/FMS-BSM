# Copy to .env and fill in the values.

PORT=5050

# MongoDB Atlas connection string. Leave empty to use a local development database (backend/.localdb).
MONGO_URI=
DB_NAME=fms_bsm

# Long random string used to sign login tokens
JWT_SECRET=

# First admin (created only when no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Admin can also sign in with this email (added to an existing admin too)
ADMIN_EMAIL=
# Lost the admin password? Set a new one here, redeploy, sign in, then DELETE this variable
ADMIN_RESET_PASSWORD=

# Google Sheets (read-only). Path to the service account JSON key file, e.g.:
# GOOGLE_SERVICE_ACCOUNT_FILE=google-key.json
GOOGLE_SERVICE_ACCOUNT_FILE=
SHEET_SYNC_MINUTES=30

# Email reminders (Gmail: smtp.gmail.com, 587, your Gmail address, an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
REMINDER_TIME=09:00

# Public URL of the app, used in password reset emails (e.g. https://fms-bsm.vercel.app)
APP_URL=

# Vercel only: random string; Vercel Cron sends it to /api/cron/* (sheet sync 8:00 IST, reminders 9:00 IST)
CRON_SECRET=

# AI Assistant (optional). Claude: ANTHROPIC_API_KEY (+ AI_MODEL, AI_EFFORT).
# Free model: AI_PROVIDER=groq | gemini | openrouter | openai-compatible (+ AI_BASE_URL), AI_API_KEY, AI_MODEL.
ANTHROPIC_API_KEY=
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_EFFORT=
AI_DAILY_LIMIT=
# Knowledge search (RAG) embeddings: default = Gemini with AI_API_KEY when AI_PROVIDER=gemini
AI_EMBED_PROVIDER=
AI_EMBED_API_KEY=
AI_EMBED_MODEL=
# Backups for a free model, tried in order when the main one fails (also _3_; _BASE_URL for openai-compatible)
AI_FALLBACK_1_PROVIDER=
AI_FALLBACK_1_API_KEY=
AI_FALLBACK_1_MODEL=
AI_FALLBACK_2_PROVIDER=
AI_FALLBACK_2_API_KEY=
AI_FALLBACK_2_MODEL=
# Each person's own Google account for the AI (read-only Drive + Sheets). OAuth client "Web application" with the
# redirect URI APP_URL/api/ai/google/callback (or set GOOGLE_OAUTH_REDIRECT_URL). Consent screen type: Internal.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=
# Optional: only this email domain may connect, e.g. bhaskarsilkmills.in
AI_GOOGLE_DOMAIN=
# Words that keep a file or tab away from the AI (comma separated; empty = inventory; "none" = nothing blocked)
AI_GOOGLE_BLOCK=
# Key for encrypting the stored Google tokens (default: derived from JWT_SECRET)
AI_TOKEN_SECRET=
