# Copy karke .env banayein aur values bharein.

PORT=5050

# MongoDB Atlas ka connection string. Khaali chhodne par local dev database chalega (backend/.localdb).
MONGO_URI=
DB_NAME=fms_bsm

# Lamba random text (login tokens ke liye)
JWT_SECRET=

# Pehla admin (sirf tab banta hai jab database me koi user na ho)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Google Sheets (read-only). Service account ki JSON key file ka path, jaise:
# GOOGLE_SERVICE_ACCOUNT_FILE=google-key.json
GOOGLE_SERVICE_ACCOUNT_FILE=
SHEET_SYNC_MINUTES=30

# Email reminder (Gmail: smtp.gmail.com, 587, apna Gmail, App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
REMINDER_TIME=09:00
