# Copy to .env and fill in the values.

PORT=5050

# MongoDB Atlas connection string. Leave empty to use a local development database (backend/.localdb).
MONGO_URI=
DB_NAME=fms_bsm

# Long random string used to sign login tokens
JWT_SECRET=

# First admin (created only when no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Admin can also sign in with this email (added to an existing admin too)
ADMIN_EMAIL=
# Lost the admin password? Set a new one here, redeploy, sign in, then DELETE this variable
ADMIN_RESET_PASSWORD=

# Google Sheets (read-only). Path to the service account JSON key file, e.g.:
# GOOGLE_SERVICE_ACCOUNT_FILE=google-key.json
GOOGLE_SERVICE_ACCOUNT_FILE=
SHEET_SYNC_MINUTES=30

# Email reminders (Gmail: smtp.gmail.com, 587, your Gmail address, an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
REMINDER_TIME=09:00

# Public URL of the app, used in password reset emails (e.g. https://fms-bsm.vercel.app)
APP_URL=

# Vercel only: random string; Vercel Cron sends it to /api/cron/* (sheet sync 8:00 IST, reminders 9:00 IST)
CRON_SECRET=
