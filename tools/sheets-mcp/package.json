{
  "name": "fms-bsm-sheets-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that lets an AI read Google Sheets, and write to them only through allow-listed, approved proposals",
  "type": "commonjs",
  "main": "dist/src/server.js",
  "bin": {
    "fms-bsm-sheets-mcp": "dist/src/server.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/src/server.js",
    "test": "tsc -p . && node --test --test-concurrency=1 \"dist/test/**/*.test.js\"",
    "typecheck": "tsc -p . --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "googleapis": "182.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
